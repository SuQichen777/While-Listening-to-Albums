DSN=your_mongodb_connection_string
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
PORT=3000
# signs the login tokens, use a long random string: openssl rand -hex 32
JWT_SECRET=your_long_random_string
# optional, python used to run crawler/cli.py (default: crawler/.venv/bin/python, then python3)
# PYTHON_BIN=/usr/bin/python3
# optional, number of reverse proxies in front of the server (so the login rate limit sees the real ip)
# TRUST_PROXY=1
